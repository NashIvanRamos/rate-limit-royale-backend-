PORT=3000
# Required. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-32+-random-chars
# Express "trust proxy" setting. "loopback" trusts X-Forwarded-For only from 127.0.0.1/::1
# (used to simulate distinct client IPs locally). Set to "false" for real-IP mode.
TRUST_PROXY=loopback
# Enables demo-only endpoints such as POST /api/demo/expired-token.
DEMO_MODE=true
CORS_ORIGIN=http://localhost:5173
